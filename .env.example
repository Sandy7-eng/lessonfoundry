# LessonFoundry — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed.
#
# Do NOT prefix AI keys with NEXT_PUBLIC_ — that would expose them to the browser.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=


# The exact OpenAI model identifier to use for generation.
# Recommended for structured educational content: gpt-4o or gpt-4o-mini
# Example: OPENAI_MODEL=gpt-4o
OPENAI_MODEL=gpt-5.6-luna

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
